# ChemVault settings. Copy to .env (gitignored) and replace the sample values.
# docker compose passes every line of .env into the container (env_file).

# Postgres. docker-compose-infar.yml creates the database with these, and the entrypoint uses them for psql.
POSTGRES_USER=chemvault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=daikon_chem_vault

# Same database as above. Needs the asyncpg driver and an explicit port.
DATABASE_URL=postgresql+asyncpg://chemvault:change-me@daikon_chem_vault_db:5432/daikon_chem_vault
LOG_LEVEL=DEBUG
LOG_JSON=False

# Bearer-token auth: required, the app won't start without the chosen provider's settings.
# Use DAIKON's values, the same ones MLogix has.
OIDCProvider=EntraID
EntraID_Instance=https://login.microsoftonline.com/
EntraID_TenantId=00000000-0000-0000-0000-000000000000
EntraID_ClientId=00000000-0000-0000-0000-000000000000
EntraID_Audience=api://00000000-0000-0000-0000-000000000000

# Or KeyCloak:
# OIDCProvider=KeyCloak
# KeyCloak_Authority=https://keycloak.example.org/realms/daikon
# KeyCloak_Audience=daikon-api

# Serves /docs, /redoc and /openapi.json without auth. Leave off in production.
ENABLE_DOCS=False
